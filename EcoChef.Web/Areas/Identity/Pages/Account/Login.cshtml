@page
@model LoginModel
@{
    ViewData["Title"] = "Autentificare";
}

<div style="max-width: 400px; margin: 60px auto;">
    <div class="card">
        <div style="text-align: center; margin-bottom: 24px;">
            <img src="~/img/eco1.png" alt="EcoChef" style="width: 150px;" />
            <h2 style="margin-top: 16px;">Bun venit!</h2>
            <p style="color: #666;">Autentifică-te pentru a continua</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Input.Email" class="control-label">Email</label>
                <input asp-for="Input.Email" class="form-control"
                       autocomplete="username" placeholder="email@exemplu.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-top: 16px;">
                <label asp-for="Input.Password" class="control-label">Parolă</label>
                <input asp-for="Input.Password" class="form-control"
                       autocomplete="current-password" placeholder="••••••" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-top: 16px;">
                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    <i class="fa-solid fa-right-to-bracket"></i> Autentificare
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}