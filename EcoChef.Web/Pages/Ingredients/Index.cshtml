@page
@model EcoChef.Web.Pages.Ingredients.IndexModel

@{
    ViewData["Title"] = "Ingrediente";
}

<h1>Pagină principală</h1>

<p>
    <a asp-page="Create">Adaugă un ingredient</a>
</p>
<!--bara de cautare-->
<input type="text" id="cautare" placeholder="Caută ingredient"
    class="form-control" style="margin-bottom: 16px; max-width: 400px;"
    onkeyup="filtreaza()" />
<select id="filtruCategorie" class="form-control" style="max-width: 200px;" onchange="filtreaza()">
    <option value="">Toate categoriile</option>
    <option value="Lactate">Lactate</option>
    <option value="Ouă">Ouă</option>
    <option value="Carne și Pește">Carne și Peste</option>
    <option value="Legume și Fructe">Legume și fructe</option>
    <option value="Cereale și Făinoase">Cereale și Făinoase</option>
    <option value="Condimente">Condimente</option>
    <option value="Băuturi">Băuturi</option>
    <option value="Altele">Altele</option>
</select>

@foreach(var categorie in Model.IngredientePeCategorie)
{
    <div class="card" style="margin-bottom: 24px;">
        <h4 style="margin-bottom: 16px;">@categorie.Key</h4>
<table class="table" id="tabel_@categorie.Key.Replace(" ", "_")">
    <thead>
        <tr>
            <th>Nume</th>
            <th>Unitate măsură</th>
            <th>Preț Achiziție</th>
            <th>Stoc curent</th>
            <th>Data expirare</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in categorie.Value) {
        <tr>
            <td>@item.Nume</td>
            <td>@item.UnitateMasura</td>
            <td>@item.PretAchizitie lei</td>
            <td>@item.StocCurent @item.UnitateMasura</td>
            <td>
                @if (item.StocCurent == 0){
                    <span style="background: #e53935; color:white; padding: 2px 8px; border-radius: 8px; font-size: 0.75rem;">Fără stoc</span>
                }else{
                @item.DataExpirare.ToString("dd/MM/yyyy")
                }
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Editează</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Detalii</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Șterge</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
}

@section Scripts {
    <script>
        function filtreaza() {
            const text = document.getElementById('cautare').value.toLowerCase();
            const categorie = document.getElementById('filtruCategorie').value.toLowerCase();
            const carduri = document.querySelectorAll('.card');

            carduri.forEach(card => {
                const numeCategorie = card.querySelector('h4').textContent.toLowerCase();

                if(categorie && !numeCategorie.includes(categorie)){
                    card.style.display='none';
                    return;
                }

                const randuri=card.querySelectorAll('tbody tr');
                let vizibile=0;

                randuri.forEach(rand => {
                    const continut = rand.textContent.toLowerCase();
                    if(continut.includes(text)){
                        rand.style.display = '';
                        vizibile++;
                    }else{
                        rand.style.display = 'none';
                    }
                });
                card.style.display = vizibile==0 ? 'none' : '';
            });
        }

    </script>
}