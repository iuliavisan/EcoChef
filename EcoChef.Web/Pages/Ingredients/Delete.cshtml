@page
@model EcoChef.Web.Pages.Ingredients.DeleteModel

@{
    ViewData["Title"] = "Șterge";
}

<h1>Șterge ingredient</h1>

<h3>Ești sigur că vrei să ștergi ingredientul?</h3>
<div>
    <h4>Ingredient</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ingredient.Nume)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ingredient.Nume)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ingredient.UnitateMasura)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ingredient.UnitateMasura)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ingredient.PretAchizitie)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ingredient.PretAchizitie)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ingredient.StocCurent)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ingredient.StocCurent)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ingredient.DataExpirare)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ingredient.DataExpirare)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Ingredient.Id" />
        <input type="submit" value="Șterge" class="btn btn-danger" /> |
        <a asp-page="./Index">Înapoi la listă</a>
    </form>
</div>
