@page
@model EcoChef.Web.Pages.Ingredients.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Ingredient</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Ingredient.Nume" class="control-label"></label>
                <input asp-for="Ingredient.Nume" class="form-control" aria-required="true"/>
                <span asp-validation-for="Ingredient.Nume" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Ingredient.UnitateMasura" class="control-label"></label>
                <input asp-for="Ingredient.UnitateMasura" class="form-control" aria-required="true"/>
                <span asp-validation-for="Ingredient.UnitateMasura" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Ingredient.PretAchizitie" class="control-label"></label>
                <input asp-for="Ingredient.PretAchizitie" class="form-control" aria-required="true"/>
                <span asp-validation-for="Ingredient.PretAchizitie" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Ingredient.StocCurent" class="control-label"></label>
                <input asp-for="Ingredient.StocCurent" class="form-control" aria-required="true"/>
                <span asp-validation-for="Ingredient.StocCurent" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Ingredient.DataExpirare" class="control-label"></label>
                <input asp-for="Ingredient.DataExpirare" class="form-control" aria-required="true"/>
                <span asp-validation-for="Ingredient.DataExpirare" class="text-danger"></span>
            </div>
            <span class="text-danger">*</span>
            <div class="form-group">
                <label asp-for="Ingredient.Categorie" class="control-label"></label>
                <select asp-for="Ingredient.Categorie" class="form-control">
                    <option value="Lactate">Lactate</option>
                    <option value="Carne și Pește">Carne și Pește</option>
                    <option value="Legume și Fructe">Legume și Fructe</option>
                    <option value="Cereale si Făinoase">Cereale și Făinoase</option>
                    <option value="Condimente">Condimente</option>
                    <option value="Băuturi">Băuturi</option>
                    <option value="Altele">Altele</option>
                </select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
