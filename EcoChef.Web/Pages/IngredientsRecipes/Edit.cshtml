@page
@model EcoChef.Web.Pages.IngredientsRecipes.EditModel

@{
    ViewData["Title"] = "Editează";
}

<h1>Editează ingredient</h1>

<h4>Ingredient-Rețetă</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IngredientReteta.Id" />
            <div class="form-group">
                <label asp-for="IngredientReteta.RetetaId" class="control-label"></label>
                <select asp-for="IngredientReteta.RetetaId" class="form-control" asp-items="ViewBag.RetetaId" ></select>
                <span asp-validation-for="IngredientReteta.RetetaId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IngredientReteta.IngredientId" class="control-label"></label>
                <select asp-for="IngredientReteta.IngredientId" class="form-control" asp-items="ViewBag.IngredientId" id="ingredientSelect" onchange="aratUnitate()" ></select>
                <span id="unitateSpan" style="font-weight: 700; color: #2d7a47; margin-left: 8px;"></span>
                <span asp-validation-for="IngredientReteta.IngredientId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IngredientReteta.CantitateNecesara" class="control-label"></label>
                <input asp-for="IngredientReteta.CantitateNecesara" class="form-control" />
                <span asp-validation-for="IngredientReteta.CantitateNecesara" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="/Recipes/Details" asp-route-id="@Model.IngredientReteta.RetetaId">Înapoi la rețetă</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const unitati = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["Unitati"]));
        function aratUnitate(){
            const id = document.getElementById('ingredientSelect').value;
            const unitate = unitati[parseInt(id)] || '';
            document.getElementById('unitateSpan').textContent=unitate;
        }
        aratUnitate();
    </script>
}
