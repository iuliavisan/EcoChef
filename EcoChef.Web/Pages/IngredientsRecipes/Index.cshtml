@page
@model EcoChef.Web.Pages.IngredientsRecipes.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<input type="text" id="cautare" placeholder="Caută rețetă"
       class="form-control" style="margin-bottom: 16px; max-width: 400px;"
       onkeyup="filtreaza()" />

@foreach(var reteta in Model.IngredientePeRetete)
{
    
<div class="card" style="margin-bottom:24px;">
    <h4 style="margin-bottom: 16px;">@reteta.Key</h4>

<table class="table">
    <thead>
        <tr>
            <th>Ingredient</th>
            <th>Cantitate</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in reteta.Value) { 
        <tr>
            <td>@item.Ingredient.Nume</td>
            <td>@item.CantitateNecesara @item.Ingredient.UnitateMasura</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Editează</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Detalii</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Șterge</a>
            </td>
        </tr>
    }

    </tbody>
</table>
</div>
}

@section Scripts {
    <script>
        function filtreaza() {
            const text = document.getElementById('cautare').value.toLowerCase();
            const randuri = document.querySelectorAll('tbody tr');

            randuri.forEach(rand => {
                const continut = rand.textContent.toLowerCase();
                rand.style.display = continut.includes(text) ? '' : 'none';
            });
        }
    </script>
}