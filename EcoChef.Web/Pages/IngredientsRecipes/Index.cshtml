@page
@model EcoChef.Web.Pages.IngredientsRecipes.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.IngredientReteta[0].Reteta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IngredientReteta[0].Ingredient)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IngredientReteta[0].CantitateNecesara)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.IngredientReteta) { //pentru fiecare rand din IngredientReteta fa un table row
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Reteta.Nume)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ingredient.Nume)
            </td>
            <td>
                @Html.DisplayFor(modelItem => @item.CantitateNecesara) @item.Ingredient.UnitateMasura
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
