@page
@model EcoChef.Web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>

<h3><b>Ingrediente care expiră în 3 zile</b></h3>

@if (Model.IngredienteExpira.Count == 0)
{
    <p class="text-success"> Niciun ingredient nu expiră curând!</p>
}
else
{
    <table class="table table-warning">
        <thead>
            <tr>
                <th>Ingredient</th>
                <th>Stoc curent</th>
                <th>Data expirare</th>
            </tr>
        </thead>

        <tbody>
        @foreach (var item in Model.IngredienteExpira)
        {
            <tr>
                <td>@item.Nume</td>
                <td>@item.StocCurent @item.UnitateMasura</td>
                <td>@item.DataExpirare.ToString("dd/MM/yyyy")</td>
            </tr>
        }
        </tbody>
    </table>

    <h3><b>Rețete recomandate</b></h3>
    <p style="color: #666;">Folosește ingredientele care expiră curând!</p>

    @if (Model.ReteteRecomandate.Count == 0)
    {
        <p class ="text-succes">Nicio recomandare momentan.</p>
    }
    else
    {
        @foreach (var reteta in Model.ReteteRecomandate)
        {
            <div class ="card" style="margin-bottom: 16px;">
                <h4>@reteta.Nume</h4>
                <p style="color: #666; font-size: 0.9rem;">Ingrediente care expiră folosite în această rețetă:</p>
                @foreach (var ir in reteta.IngredientReteta
                
                    .Where(ir => Model.IngredienteExpira.Select(i => i.Id).Contains(ir.IngredientId)))
                    {
                        <span style="background: rgba(255,200,0,0.2); padding:4px 10px; border-radius: 8px; margin-right: 8px; font-weight:700;">
                            @ir.Ingredient.Nume
                        </span>
                    }
                
            </div>
        }
    }
}