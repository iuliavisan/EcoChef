@page
@model EcoChef.Web.Pages.Losses.DeleteModel

@{
    ViewData["Title"] = "Șterge";
}

<h1>Șterge pierdere</h1>

<h3>Ești sigur că vrei să ștergi această pierdere?</h3>
<div>
    <h4>Pierdere</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Pierdere.Ingredient)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Pierdere.Ingredient.Nume)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Pierdere.CantitatePierdere)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Pierdere.CantitatePierdere)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Pierdere.MotivPierdere)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Pierdere.MotivPierdere)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Pierdere.DataPierdere)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Pierdere.DataPierdere)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Pierdere.PretPierdere)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Pierdere.PretPierdere)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Pierdere.Id" />
        <input type="submit" value="Șterge" class="btn btn-danger" /> |
        <a asp-page="./Index">Înapoi la pierderi</a>
    </form>
</div>
