@page
@model EcoChef.Web.Pages.Losses.CreateModel

@{
    ViewData["Title"] = "Creează";
}

<h1>Adaugă pierdere</h1>

<h4>Pierdere</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Pierdere.IngredientId" class="control-label"></label>
                <select asp-for="Pierdere.IngredientId" class ="form-control" 
                    asp-items="ViewBag.IngredientId" 
                    aria-required="true"
                    id="ingredientSelect"
                    onchange="aratUnitate()">
                </select>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Pierdere.CantitatePierdere" class="control-label"></label>
                <input asp-for="Pierdere.CantitatePierdere" class="form-control" aria-required="true"/>
                <span asp-validation-for="Pierdere.CantitatePierdere" class="text-danger"></span>
                <span id="unitateSpan" style="font-weight: 700; color: #2d7a4f; margin-left: 8px;"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Pierdere.MotivPierdere" class="control-label"></label>
                <input asp-for="Pierdere.MotivPierdere" class="form-control" aria-required="true"/>
                <span asp-validation-for="Pierdere.MotivPierdere" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Pierdere.DataPierdere" class="control-label"></label>
                <input asp-for="Pierdere.DataPierdere" class="form-control" />
                <span asp-validation-for="Pierdere.DataPierdere" class="text-danger"></span>
            </div>
      
            <div class="form-group">
                <input type="submit" value="Înregistrează pierdere" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Înapoi la pierderi</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const unitati = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["Unitati"]));

        function aratUnitate(){
            const id = document.getElementById('ingredientSelect').value;
            console.log('id selectat:', id);
            console.log('unitati:', unitati);
            const unitate = unitati[parseInt(id)] || '';
            document.getElementById('unitateSpan').textContent = unitate;
        }
        aratUnitate();
    </script>
}
