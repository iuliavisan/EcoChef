@page
@model EcoChef.Web.Pages.Losses.IndexModel

@{
    ViewData["Title"] = "Pierderi";
    var ziuaAnterioara = Model.DataSelectata.AddDays(-1).ToString("yyyy-MM-dd");
    var ziuaUrmatoare = Model.DataSelectata.AddDays(+1).ToString("yyyy-MM-dd");
}

<h1>Pagina principală pierderi</h1>

<div style ="display: flex; align-items: center; gap:16px; margin-bottom: 24px;">
    <a asp-page="./Index"
        asp-route-data ="@ziuaAnterioara"
        class="btn btn-secondary">Ziua anterioară</a>

    <h3 style="margin: 0; color: #2d7a4f;"></h3>
        @Model.DataSelectata.ToString("dd MMMM yyyy")
    </h3>

    @if(Model.DataSelectata.Date < DateTime.Today)
    {
        <a asp-page="./Index"
            asp-route-data ="@ziuaUrmatoare"
            class="btn btn-secondary">Ziua următoare</a>
    }
</div>

<p>
    <a asp-page="Create">Adaugă pierdere</a>
</p>

@foreach (var zi in Model.PierderiPeZile)
{
    <div class="card" style="margin-bottom: 24px;">
        <h4 style="margin-bottom: 16px;">
            @zi.Key.ToString("dd MMMM yyyy")
        <span style="font-size: 0.85rem; color: #666; font-weight:600; margin-left: 12px;">
        </span>
        </h4>


<table class="table">
    <thead>
        <tr>
            <th>Ingredient</th>
            <th>Cantitate</th>
            <th>Motiv</th>
            <th>Valoare</th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in zi.Value)
    {
    <tr>
        <td>@item.Ingredient.Nume</td>
        <td>@item.CantitatePierdere @item.Ingredient.UnitateMasura</td>
        <td>@item.MotivPierdere</td>
        <td>@item.PretPierdere.ToString("0.00") lei</td>
        <td>
           <a asp-page="./Edit" asp-route-id="@item.Id">Editează</a> |
           <a asp-page="./Details" asp-route-id="@item.Id">Detalii</a> |
           <a asp-page="./Delete" asp-route-id="@item.Id">Șterge</a>
        </td>
    </tr>
    }

    </tbody>
</table>
</div>
}