@page
@model EcoChef.Web.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Administrare Utilizatori";
}

<h1>Utilizatori</h1>

<div class="card" style="margin-bottom: 32px; max-width: 400px";>
    <h4>Adaugă utilizator nou</h4>
    <form method="post">
        <div class="form-group">
            <label class="control-laber">Email</label>
            <input asp-for="Email" class="form-control" type="email" required />
        </div>

        <div class="form-group">
            <label class="control-label">Parolă</label>
            <input asp-for="Parola" class="form-control" type="password" required />
        </div>

        <div class="form-group">
            <label class="control-label">Rol</label>
            <select asp-for="Rol" class="form-control">
                <option value="Admin">Admin</option>
                <option value="Manager">Manager</option>
                <option value="Bucatar">Bucătar</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top: 8px;">
            Adaugă membru
        </button>
    </form>
</div>


<h4>Utilizatori existenți</h4>
<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Rol</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach(var user in Model.Utilizatori)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    @{
                        var rol = @Model.RoluriUtilizator.ContainsKey(user.Id) ? Model.RoluriUtilizator[user.Id] : "Fără rol";
                        }
                        @rol
                        </td>
                        <td>
                    <form method="post" asp-page-handler ="Sterge" asp-route-id="@user.Id"
                            onsubmit="return confirm('Sigur vrei să ștergi acest membru?')">
                            <button type="submit" class="btn btn-danger" style="padding: 4px 12px; font-size: 0.85rem;">
                                Șterge
                            </button>
                        </form>
                </td>
            </tr>
        }
    </tbody>
</table>