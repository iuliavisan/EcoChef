@page
@model EcoChef.Web.Pages.Recipes.IndexModel
@{
    ViewData["Title"] = "Rețete";
}

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    <h1 style="margin: 0;">Rețete</h1>
    <a asp-page="Create" class="btn btn-primary">+ Rețetă nouă</a>
</div>

<input type="text" id="cautare" placeholder="Caută rețetă..."
       class="form-control" style="margin-bottom: 24px; max-width: 400px;"
       onkeyup="filtreaza()" />

@foreach (var categorie in Model.RetetePerCategorie)
{
    <div class="categorie-grup" style="margin-bottom: 40px;">
        <h3 style="margin-bottom: 16px; padding-bottom: 8px; border-bottom: 2px solid rgba(67,198,122,0.3);">
            @categorie.Key
        </h3>
        <div style="display: flex; flex-wrap: wrap; gap: 16px;">
            @foreach (var item in categorie.Value)
            {
                var costProductie = item.IngredientReteta?.Sum(ir => ir.CantitateNecesara * ir.Ingredient.PretAchizitie) ?? 0;
                var pretMeniu = costProductie + (costProductie * Model.MarjaProfit / 100);
                var profitPortie = pretMeniu - costProductie;

                <div class="reteta-card">
                    @if (!string.IsNullOrEmpty(item.ImagineReteta))
                    {
                        <img src="~/img/@item.ImagineReteta"
                        style="width: 100%; height:140px; object-fit:cover; border-radius: 16px 16px 0 0;" />
                    }
                    <div class="reteta-card-header">
                        @item.Nume
                    </div>
                    <div class="reteta-card-body">
                        <div class="reteta-stat">
                            <span>⏱️</span> @item.TimpPreparare min
                        </div>
                        <div class="reteta-stat">
                            <span>💰</span> Cost: @costProductie.ToString("0.00") lei
                        </div>
                        <div class="reteta-stat">
                            <span>📈</span> Profit: @profitPortie.ToString("0.00") lei
                        </div>
                        <div class="reteta-stat">
                            <span>🏷️</span> Preț: @pretMeniu.ToString("0.00") lei
                        </div>
                    </div>
                    <div class="reteta-card-footer">
                        <a asp-page="./Details" asp-route-id="@item.Id">Detalii</a>
                        <a asp-page="./Edit" asp-route-id="@item.Id">Editează</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id">Șterge</a>
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        function filtreaza() {
            const text = document.getElementById('cautare').value.toLowerCase();
            const carduri = document.querySelectorAll('.reteta-card');
            const grupuri = document.querySelectorAll('.categorie-grup');

            carduri.forEach(card => {
                const continut = card.textContent.toLowerCase();
                card.style.display = continut.includes(text) ? '' : 'none';
            });

            grupuri.forEach(grup => {
                const vizibile = [...grup.querySelectorAll('.reteta-card')]
                    .filter(c => c.style.display !== 'none');
                grup.style.display = vizibile.length === 0 ? 'none' : '';
            });
        }
    </script>
}