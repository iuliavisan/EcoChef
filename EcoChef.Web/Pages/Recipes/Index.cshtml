@page
@model EcoChef.Web.Pages.Recipes.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Reteta[0].Nume)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reteta[0].Instructiuni)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reteta[0].TimpPreparare)
            </th>
            <th>
                Cost producție per porție
            </th>
            <th>
                Profit per porție
            </th>
            <th>
                Marjă profit
            </th>
            <th>
                Preț meniu
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Reteta) {
            
                var costProductie = item.IngredientReteta?.Sum(ir => ir.CantitateNecesara * ir.Ingredient.PretAchizitie) ?? 0;
                var marjaProfit = Model.MarjaProfit;
                var pretMeniu = costProductie + (costProductie * marjaProfit / 100);
                var profitPortie = pretMeniu - costProductie;
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nume)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Instructiuni)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TimpPreparare)
            </td>
            <td>
                @costProductie.ToString("0.00") lei
            </td>
            <td>
                @Math.Round(profitPortie, 2).ToString("0.00") lei
            </td>
            <td>
                @marjaProfit %
            </td>
            <td>
                @pretMeniu.ToString("0.00") lei 
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
