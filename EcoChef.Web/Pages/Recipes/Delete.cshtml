@page
@model EcoChef.Web.Pages.Recipes.DeleteModel

@{
    ViewData["Title"] = "Șterge";
}

<h1>Șterge rețetă</h1>

<h3>Ești sigur că vrei să ștergi rețeta?</h3>
<div>
    <h4>Reteta</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Reteta.Nume)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Reteta.Nume)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Reteta.Instructiuni)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Reteta.Instructiuni)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Reteta.TimpPreparare)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Reteta.TimpPreparare)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Reteta.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Înapoi la rețete</a>
    </form>
</div>
