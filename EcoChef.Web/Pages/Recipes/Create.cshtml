@page
@model EcoChef.Web.Pages.Recipes.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Reteta</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Reteta.Nume" class="control-label"></label>
                <input asp-for="Reteta.Nume" class="form-control" aria-required="true"/>
                <span asp-validation-for="Reteta.Nume" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reteta.Instructiuni" class="control-label"></label>
                <input asp-for="Reteta.Instructiuni" class="form-control" />
                <span asp-validation-for="Reteta.Instructiuni" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reteta.TimpPreparare" class="control-label"></label>
                <input asp-for="Reteta.TimpPreparare" class="form-control" />
                <span asp-validation-for="Reteta.TimpPreparare" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Reteta.Categorie" class="control-label"></label>
                <select asp-for="Reteta.Categorie" class="form-control">
                    <option value="Pizza și Paste">🍕 Pizza și Paste</option>
                    <option value="Carne și Pește">🥩 Carne și Pește</option>
                    <option value="Ouă și Lactate">🥚 Ouă și Lactate</option>
                    <option value="Supe și Ciorbe">🥣 Supe și Ciorbeă</option>
                    <option value="Deserturi">🍰 Deserturi</option>
                    <option value="Salate">🥗 Salate</option>
                    <option value="Altele">Altele</option>

                </select>
            </div>

            <div class="form-group">
                <label class="control-panel">Imagine rețetă</label>
                <input type="file" name="poza" accept="image/*" class="form-control" />
            </div>


            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
            
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
