@page
@model EcoChef.Web.Pages.Recipes.DetailsModel

@{
    ViewData["Title"] = "Detalii rețetă";
}

<h1>@Model.Reteta.Nume</h1>
<hr />

<div class="card" style="margin-bottom: 24px;">
    <dl class="row">
        <dt class="col-sm-3">Instrucțiuni</dt>
        <dd class="col-sm-9">@Model.Reteta.Instructiuni</dd>

        <dt class="col-sm-3">Timp preparare</dt>
        <dd class="col-sm-9">@Model.Reteta.TimpPreparare minute</dd>

        <dt class="col-sm-3">Marjă profit</dt>
        <dd class="col-sm-9">@Model.MarjaProfit %</dd>    
    </dl>
</div>

<h4>Ingrediente</h4>
<table class="table">
    <thead>
        <tr>
            <th>Ingredient</th>
            <th>Cantitate</th>
            <th?></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Ingrediente)
        {
            <tr>
                <td>@item.Ingredient.Nume</td>
                <td>@item.CantitateNecesara @item.Ingredient.UnitateMasura</td>
                <td>
                    <a asp-page ="/IngredientsRecipes/Edit" asp-route-id ="@item.Id">Editează</a>
                    <a asp-page ="/IngredientsRecipes/Delete" asp-route-id ="@item.Id">Șterge</a>

                </td>
            </tr>
        }
    </tbody>
</table>
<a asp-page ="/IngredientsRecipes/Create"
    asp-route-retetaId="@Model.Reteta.Id"
    class="btn btn-primary" style="margin-top: 8px;">
    + Adaugă ingredient
    </a>
<div style="margin-top: 80px;">
    <a asp-page="./Edit" asp-route-id="@Model.Reteta.Id" class="btn btn-secondary">Editează rețetă </a> |
    <a asp-page="./Index" class="btn btn-secondary">Înapoi la rețete</a>
</div>
