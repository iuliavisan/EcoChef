@page
@model EcoChef.Web.Pages.Settings.IndexModel

@{
    ViewData["Title"] = "Setări";
}

<h1>Setări admin</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                Marjă Profit (%)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Setari) {
        <tr>
            <td>
                @item.MarjaProfit %
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Editează</a> |
            </td>
        </tr>
}
    </tbody>
</table>
