@page
@model EcoChef.Web.Pages.Settings.EditModel

@{
    ViewData["Title"] = "Editează";
}

<h1>Editează setare</h1>

<h4>Setări</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Setari.Id" />
            <div class="form-group">
                <label asp-for="Setari.MarjaProfit" class="control-label"></label>
                <input asp-for="Setari.MarjaProfit" class="form-control" />
                <span asp-validation-for="Setari.MarjaProfit" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Înapoi la setări</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
