<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoChef</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcoChef.Web.styles.css" asp-append-version="true" />
    <!-- Font Awesome pentru iconite -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body>
    <div class="app-wrapper">

        <!-- SIDEBAR -->
        <div class="sidebar">
            <!-- Logo/Nume aplicatie -->
            <div class="sidebar-brand">
                <img src="~/img/eco1.png" alt="EcoChef" style="width: 180px; height: auto; margin: 0; display: block;"/>
            </div>

            <!-- Linkuri navigare -->
            <nav class="sidebar-nav">
                <a class="sidebar-link" asp-page="/Index">
                    <i class="fa-solid fa-house"></i> Home
                </a>
                <a class="sidebar-link" asp-page="/Dashboard/Index">
                    <i class="fa-solid fa-gauge"></i> Dashboard
                </a>

                <div class="sidebar-section">Gestiune</div>
                <a class="sidebar-link" asp-page="/Ingredients/Index">
                    <i class="fa-solid fa-carrot"></i> Ingrediente
                </a>
                <a class="sidebar-link" asp-page="/Recipes/Index">
                    <i class="fa-solid fa-book-open"></i> Rețete
                </a>

                <div class="sidebar-section">Operațiuni</div>
                <a class="sidebar-link" asp-page="/Cooking/Index">
                    <i class="fa-solid fa-fire-burner"></i> Gătire
                </a>
                <a class="sidebar-link" asp-page="/Losses/Index">
                    <i class="fa-solid fa-triangle-exclamation"></i> Pierderi
                </a>

                <div class="sidebar-section">Analiză</div>
                <a class="sidebar-link" asp-page="/Reports/Index">
                    <i class="fa-solid fa-chart-bar"></i> Rapoarte
                </a>
                <a class="sidebar-link" asp-page="/Settings/Index">
                    <i class="fa-solid fa-gear"></i> Setări
                </a>
            </nav>

            <div style="padding: 12px;">
                @if (User.Identity.IsAuthenticated)
                {
                    <form method="post" action="/Identity/Account/Logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sidebar-link" style="width: 100%; border: none; background: none; cursor: pointer;">
                            <i class="fa-solid fa-right-from-bracket"></i> Logout
                        </button>
                    </form>
                    <div style="font-size: 0.8rem; color: #666; padding: 8px 14px;">
                        @User.Identity.Name
                    </div>
                }
                else
                {
                    <a class="sidebar-link" href="/Identity/Account/Login">
                        <i class="fa-solid fa-right-to-bracket"></i> Login
                    </a>
                }
            </div>

            <!-- Footer sidebar -->
            <div class="sidebar-footer">
                <span>© 2026 EcoChef</span>
            </div>
        </div>

        <!-- MAIN AREA -->
        <div class="main-area">
            <!-- Top bar -->
            <div class="top-bar">
                <span class="top-bar-title">@ViewData["Title"]</span>
            </div>

            <!-- Content -->
            <div class="content">
                @RenderBody()
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>